{
  "name": "town",
  "private": true,
  "description": "The management UI for the Pi agent platform: a Hono BFF that holds the user session, and a React front end.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/server/index.ts",
    "dev": "vite",
    "build": "vite build",
    "test": "npm run test:server && npm run test:client",
    "test:server": "node --test \"src/server/**/*.test.ts\"",
    "test:client": "node --import tsx --test \"src/client/**/*.test.tsx\"",
    "typecheck": "tsc --noEmit && tsc -p src/server/tsconfig.json --noEmit",
    "lint": "eslint .",
    "knip": "knip",
    "dupes": "jscpd --config .jscpd.json ."
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "hono": "4.13.12",
    "jose": "6.2.12",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "jscpd": "5.4.0",
    "jsdom": "30.1.1",
    "knip": "6.39.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2"
  }
}
